local WeaponDropdown = MainTab:CreateDropdown({
    Name = "Weapon",
        Description = "The weapon that will be used",
    Options = {"Melee","Sword", "Blox Fruit"},
        CurrentOption = {"Melee"},
        MultipleOptions = false,
        SpecialType = nil,
        Callback = function(Options)
             if (Options == "Melee") then
                for i, p in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
                    if (p.ToolTip == "Melee") then
                        if game.Players.LocalPlayer.Backpack:FindFirstChild(tostring(p.Name)) then
                            SelectedWeapon = p.Name;
                        end
                    end
                end
            elseif (Options == "Sword") then
                for j, v in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
                    if (v.ToolTip == "Sword") then
                        if game.Players.LocalPlayer.Backpack:FindFirstChild(tostring(v.Name)) then
                            SelectedWeapon = v.Name;
                        end
                    end
                end
            elseif (Options == "Blox Fruit") then
                for k, l in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
                    if (l.ToolTip == "Blox Fruit") then
                        if game.Players.LocalPlayer.Backpack:FindFirstChild(tostring(l.Name)) then
                            SelectedWeapon = l.Name;
                        end
                    end
                end
    end
}, "WeaponDropdown")

