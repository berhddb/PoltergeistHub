-- Funções auxiliares
local function safeFind(instance, child)
    return instance and instance:FindFirstChild(child)
end

local function safePosition(part)
    return part and part:IsA("BasePart") and part.Position or nil
end

local function getHumanoidRootPart()
    -- More robust check
    if not player then return nil end
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

-- Retorna o gerador mais próximo que não está completo e não está ocupado por outro jogador (ou está ocupado por nós mesmos)
local function getClosestGenerator()
    local cr = workspace:FindFirstChild("CurrentRoom")
    local rooms = cr and cr:GetChildren() or {}
    local room = nil

    -- Encontra o modelo de sala mais recente
    for i = #rooms, 1, -1 do
        if rooms[i]:IsA("Model") then
            room = rooms[i]
            break
        end
    end
    if not room then return nil end

    local generators = safeFind(room, "Generators")
    local list = generators and generators:GetChildren() or {}

    local hrp = getHumanoidRootPart()
    if not hrp then return nil end
    local hrpPos = hrp.Position

    local closestGen, minDist = nil, math.huge

    for _, g in ipairs(list) do
        local stats = safeFind(g, "Stats")
        local completed = stats and safeFind(stats, "Completed")
        local active = stats and safeFind(stats, "ActivePlayer") -- ObjectValue expected
        local prompt = safeFind(g, "Prompt")
        local promptPos = safePosition(prompt)

        if promptPos and completed and not completed.Value then
            -- Checa se está livre ou se nós estamos usando
            local isActiveByOther = active and active.Value and active.Value ~= player and active.Value ~= player.Character and active.Value ~= player.Name
            if not isActiveByOther then
                local dist = (hrpPos - promptPos).Magnitude
                if dist < minDist then
                    closestGen, minDist = g, dist
                end
            end
        end
    end

    return closestGen
end

-- Move para o prompt e ESPERA a conclusão ou cancelamento. Retorna true se completou, false se cancelou/falhou.
local function moveToPromptYield(prompt)
    local hrp = getHumanoidRootPart()
    if not hrp or not prompt or not prompt:IsA("BasePart") then return false end

    local targetCFrame = prompt.CFrame * CFrame.new(0, 0, -3) -- Slightly adjusted offset
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = math.max(0.5, distance * 0.06) -- Adjusted duration calculation, minimum 0.5s

    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = targetCFrame
    })

    local connection
    local completed = false
    local cancelled = false

    -- Adiciona à lista para possível cancelamento externo
    table.insert(ActiveTweens, tween)

    -- Função para limpar esta tween específica
    local function cleanupTween()
        if connection then connection:Disconnect() connection = nil end
        for i, t in ipairs(ActiveTweens) do
            if t == tween then
                table.remove(ActiveTweens, i)
                break
            end
        end
    end

    -- Conecta ao Completed
    connection = tween.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then
            completed = true
        else -- Cancelled or Stopped
            cancelled = true
        end
        cleanupTween()
    end)

    tween:Play()

    -- Espera até que a tween termine ou seja cancelada pelo StopTweensFlag
    while not completed and not cancelled and not StopTweensFlag do
        task.wait(0.1)
    end

    -- Se foi cancelada pelo flag, garante que a tween pare e limpe
    if StopTweensFlag and not completed and not cancelled then
         pcall(function() tween:Cancel() end)
         cleanupTween()
         return false -- Considera cancelado
    end

    return completed -- Retorna true apenas se completou naturalmente
end


