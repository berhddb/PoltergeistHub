-- Noclip Feature
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Noclip = false
local noclipConnection
local originalCollisions = {} -- Armazena as colisões originais

local function isValidGround(result, originY)
    if not result then return false end

    local part = result.Instance
    if not part or not part:IsA("BasePart") or not part.Anchored then return false end

    local normal = result.Normal
    local distance = originY - result.Position.Y
    return normal.Y >= 0.9 and distance <= 12
end

local function enableNoclip()
    local character = player.Character
    if not character then return end

    -- Desativa colisão do personagem
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    noclipConnection = RunService.Stepped:Connect(function()
        if not character or not character.Parent then return end

        local hrp = character:WaitForChild("HumanoidRootPart")
        local origin = hrp.Position
        local direction = Vector3.new(0, -12, 0)
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {character}
        params.FilterType = Enum.RaycastFilterType.Exclude

        local result = Workspace:Raycast(origin, direction, params)
        local groundedPart = (result and isValidGround(result, origin.Y)) and result.Instance or nil

        -- Atravessa tudo, exceto o chão
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and not part:IsDescendantOf(character) then
                if not originalCollisions[part] then
                    originalCollisions[part] = part.CanCollide
                end
                if groundedPart and part == groundedPart then
                    part.CanCollide = originalCollisions[part] -- Restaura a colisão original se for o chão
                else
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function disableNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    -- Restaura colisão do personagem
    local character = player.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end

    -- Restaura a colisão original de todas as partes
    for part, original in pairs(originalCollisions) do
        if part and part:IsDescendantOf(Workspace) then
            part.CanCollide = original
        end
    end
    table.clear(originalCollisions)
end

