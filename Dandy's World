-- Espera pela conclusão do gerador. Retorna true se completou, false se interrompido.
local function waitForCompletion(generator)
    local stats = generator and generator:FindFirstChild("Stats")
    local completed = stats and stats:FindFirstChild("Completed")
    if not completed then return false end -- Gerador inválido

    while completed.Value == false do
        if not AutoFarm or GettingChased() then
            return false -- Interrompido
        end
        task.wait(0.2)
    end
    return true -- Completou
end

-- Inicia a mecânica de esconder (subir e pairar)
local function startHiding()
    if isHiding then return end -- Já está se escondendo
    isHiding = true
    currentState = "Hiding"
    print("Auto Farm: Being chased! Initiating hide...")

    -- Cancela qualquer movimento de gerador atual
    StopTweensFlag = true
    for _, tween in pairs(ActiveTweens) do pcall(function() tween:Cancel() end) end
    ActiveTweens = {}
    StopTweensFlag = False -- Reset flag after use

    local hrp = getHumanoidRootPart()
    if not hrp then isHiding = false; currentState = "Idle"; return end

    -- Limpa física de esconder anterior, se houver
    if hideVelocity then pcall(function() hideVelocity:Destroy() end); hideVelocity = nil end
    if hideAttachment then pcall(function() hideAttachment:Destroy() end); hideAttachment = nil end

    -- Cria Attachment e LinearVelocity
    hideAttachment = Instance.new("Attachment", hrp)
    hideVelocity = Instance.new("LinearVelocity", hideAttachment)
    hideVelocity.Attachment0 = hideAttachment
    hideVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    hideVelocity.MaxForce = HOVER_MAX_FORCE -- Força alta para subir rápido e pairar

    -- Impulso inicial para cima
    hideVelocity.VectorVelocity = Vector3.new(0, HIDE_VELOCITY_MAGNITUDE, 0)
    hideVelocity.Enabled = true

    -- Após um curto período, para o impulso e começa a pairar (velocidade zero, força alta)
    task.delay(HIDE_ASCEND_DURATION, function()
        if hideVelocity then -- Verifica se ainda existe
             hideVelocity.VectorVelocity = Vector3.new(0, 0, 0)
             print("Auto Farm: Reached hover altitude.")
        end
    end)
end

-- Para a mecânica de esconder (remove física, permite cair)
local function stopHiding()
    if not isHiding then return end -- Não está se escondendo
    print("Auto Farm: No longer chased. Stopping hide...")
    if hideVelocity then pcall(function() hideVelocity:Destroy() end); hideVelocity = nil end
    if hideAttachment then pcall(function() hideAttachment:Destroy() end); hideAttachment = nil end
    isHiding = false
    currentState = "Idle" -- Volta ao estado ocioso para procurar gerador
end

local function checkElevator()
    local elevator = workspace:FindFirstChild("Elevator")
    local elevatorBase = elevator and elevator:FindFirstChild("ElevatorBase")
    local hrp = getHumanoidRootPart()
    if not elevatorBase or not hrp then return false end

    -- Calcula distância horizontal para ignorar altura
    local hrpPos2D = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
    local elevPos2D = Vector3.new(elevatorBase.Position.X, 0, elevatorBase.Position.Z)

    return (hrpPos2D - elevPos2D).Magnitude < 20 -- Aumenta um pouco o raio de checagem
end



